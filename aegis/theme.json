{
  "$schema": "https://schemas.wp.org/wp/6.7/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "layout": {
      "contentSize": "720px",
      "wideSize": "1280px"
    },
    "color": {
      "defaultPalette": false,
      "palette": [
        { "slug": "paper", "color": "#f3f0e9", "name": "Бумага" },
        { "slug": "surface", "color": "#faf8f3", "name": "Поверхность" },
        { "slug": "ink", "color": "#172033", "name": "Чернила" },
        { "slug": "navy", "color": "#16233a", "name": "Флотский" },
        { "slug": "burgundy", "color": "#861f32", "name": "Сигнальный" },
        { "slug": "bronze", "color": "#8a6a3d", "name": "Память" },
        { "slug": "muted", "color": "#5d6470", "name": "Приглушённый" }
      ]
    },
    "typography": {
      "fluid": true,
      "fontFamilies": [
        {
          "slug": "display",
          "name": "Source Serif 4",
          "fontFamily": "\"Source Serif 4\", \"PT Serif\", Georgia, serif"
        },
        {
          "slug": "body",
          "name": "Manrope",
          "fontFamily": "Manrope, Arial, sans-serif"
        },
        {
          "slug": "mono",
          "name": "IBM Plex Mono",
          "fontFamily": "\"IBM Plex Mono\", ui-monospace, monospace"
        }
      ]
    },
    "spacing": {
      "units": ["px", "rem", "vw", "vh", "%"]
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--paper)",
      "text": "var(--wp--preset--color--ink)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--body)",
      "fontSize": "1.05rem",
      "lineHeight": "1.65"
    },
    "elements": {
      "heading": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--display)",
          "lineHeight": "1.12"
        }
      },
      "link": {
        "color": {
          "text": "var(--wp--preset--color--burgundy)"
        }
      },
      "button": {
        "color": {
          "background": "var(--wp--preset--color--burgundy)",
          "text": "#fffdfa"
        },
        "border": {
          "radius": "2px"
        }
      }
    }
  },
  "templateParts": [
    { "name": "header", "title": "Шапка", "area": "header" },
    { "name": "footer", "title": "Подвал", "area": "footer" }
  ]
}
