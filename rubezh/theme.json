{
  "$schema": "https://schemas.wp.org/wp/6.7/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "layout": {
      "contentSize": "72ch",
      "wideSize": "1320px"
    },
    "color": {
      "defaultPalette": false,
      "palette": [
        { "slug": "ink", "color": "#141820", "name": "Чернила" },
        { "slug": "paper", "color": "#f3efe6", "name": "Бумага" },
        { "slug": "paper-2", "color": "#faf7f0", "name": "Бумага светлая" },
        { "slug": "navy", "color": "#152033", "name": "Гражданский navy" },
        { "slug": "burgundy", "color": "#7e2433", "name": "Действие" },
        { "slug": "bronze", "color": "#b8893d", "name": "Память" },
        { "slug": "muted", "color": "#5c6170", "name": "Приглушённый" }
      ]
    },
    "typography": {
      "fluid": true,
      "fontFamilies": [
        {
          "slug": "display",
          "name": "Newsreader",
          "fontFamily": "Newsreader, PT Serif, Georgia, serif"
        },
        {
          "slug": "body",
          "name": "Manrope",
          "fontFamily": "Manrope, Arial, sans-serif"
        },
        {
          "slug": "mono",
          "name": "IBM Plex Mono",
          "fontFamily": "IBM Plex Mono, ui-monospace, monospace"
        }
      ]
    },
    "useRootPaddingAwareAlignments": true
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--paper)",
      "text": "var(--wp--preset--color--ink)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--body)",
      "fontSize": "1.05rem",
      "lineHeight": "1.65"
    },
    "elements": {
      "h1": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--display)",
          "fontWeight": "500",
          "lineHeight": "1.02"
        }
      },
      "h2": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--display)",
          "lineHeight": "1.08"
        }
      },
      "link": {
        "color": { "text": "inherit" }
      },
      "button": {
        "color": {
          "background": "var(--wp--preset--color--burgundy)",
          "text": "#fffdfa"
        },
        "border": { "radius": "2px" }
      }
    }
  },
  "templateParts": [
    { "name": "header", "title": "Шапка", "area": "header" },
    { "name": "footer", "title": "Подвал", "area": "footer" }
  ]
}
