{
  "$schema": "https://schemas.wp.org/wp/6.7/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": false,
    "layout": {
      "contentSize": "720px",
      "wideSize": "1120px"
    },
    "color": {
      "defaultPalette": false,
      "palette": [
        { "slug": "ink", "color": "#e8eef8", "name": "Свет звёзд" },
        { "slug": "paper", "color": "#070b14", "name": "Космос" },
        { "slug": "teal", "color": "#9ae7ff", "name": "Сигнал" },
        { "slug": "copper", "color": "#f0c56a", "name": "Звезда" }
      ]
    },
    "typography": {
      "fluid": false,
      "fontFamilies": [
        {
          "slug": "literata",
          "name": "Literata",
          "fontFamily": "Literata, Georgia, serif"
        },
        {
          "slug": "manrope",
          "name": "Manrope",
          "fontFamily": "Manrope, sans-serif"
        }
      ]
    }
  },
  "styles": {
    "color": {
      "background": "#070b14",
      "text": "#e8eef8"
    },
    "typography": {
      "fontFamily": "Literata, Georgia, serif",
      "fontSize": "1.125rem",
      "lineHeight": "1.65"
    },
    "elements": {
      "link": {
        "color": { "text": "#9ae7ff" }
      },
      "heading": {
        "typography": {
          "fontFamily": "Literata, Georgia, serif",
          "fontWeight": "620"
        }
      }
    }
  }
}
